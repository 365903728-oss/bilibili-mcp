{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XZXZZX-Ai/bilibili-mcp/harness/contracts/task-contract-v1.schema.json",
  "title": "Harness Task Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task",
    "execution",
    "writer_lease",
    "acceptance_owner",
    "authority",
    "state",
    "terminal_states",
    "required_manual_skills"
  ],
  "properties": {
    "schema": { "const": "harness.task-contract/v1" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:#-]+$" },
        "source": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "canonical_worktree", "base_sha", "adapter_switch_policy"],
      "properties": {
        "mode": {
          "enum": ["codex-direct", "codex-paseo-claude", "claude-direct"]
        },
        "canonical_worktree": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "base_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "adapter_switch_policy": { "const": "stop-and-report" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "owned_paths",
        "acceptance_criteria",
        "verification_plan",
        "repair_policy",
        "stop_conditions"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9_.:#-]+$" },
              "description": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "verification_plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "required"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9_.:#-]+$" },
              "command": { "type": "string", "minLength": 1, "maxLength": 512 },
              "required": { "type": "boolean" }
            }
          }
        },
        "repair_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts"],
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        }
      }
    },
    "writer_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "state"],
      "properties": {
        "holder": { "type": ["string", "null"], "enum": ["codex", "claude", null] },
        "state": { "enum": ["inactive", "active", "released"] }
      }
    },
    "acceptance_owner": { "enum": ["codex", "claude"] },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_read_write_test",
        "local_commit",
        "push_pr_tag_release_publish",
        "credentials_ssh_broad_delete_history_rewrite"
      ],
      "properties": {
        "local_read_write_test": { "const": "allowed" },
        "local_commit": { "const": "after-acceptance" },
        "push_pr_tag_release_publish": { "const": "user-approval-required" },
        "credentials_ssh_broad_delete_history_rewrite": { "const": "blocked" }
      }
    },
    "state": {
      "enum": [
        "draft",
        "ready",
        "mode-frozen",
        "baselined",
        "executing",
        "verifying",
        "reviewing",
        "repairing",
        "accepted",
        "blocked",
        "cancelled",
        "recovery-required"
      ]
    },
    "terminal_states": {
      "const": ["accepted", "blocked", "cancelled", "recovery-required"]
    },
    "required_manual_skills": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "host", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$" },
          "host": { "enum": ["codex", "claude"] },
          "status": { "enum": ["required", "reminded", "invoked"] },
          "invocation": { "type": "string", "maxLength": 66 }
        }
      }
    }
  }
}
